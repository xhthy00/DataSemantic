# Use: python3 scripts/init_env.py
# This file contains no usable default credential.
WREN_SERVICE_TOKEN=
WREN_REGISTRY_PATH=models/registry.json
WREN_PLAN_TIMEOUT_SECONDS=15
WREN_STARTUP_TIMEOUT_SECONDS=60
WREN_MAX_CONCURRENT_PLANS=2
WREN_MAX_REQUEST_BYTES=65536

# Optional physical SQL execution. Passwords are resolved from process environment.
# WREN_EXECUTION_SOURCES_PATH=config/execution-sources.json
WREN_EXECUTION_TIMEOUT_SECONDS=15
WREN_MAX_CONCURRENT_EXECUTIONS=2
WREN_EXECUTION_MAX_RESULT_BYTES=4194304

# Optional MDL authoring console. Choose a separate password (12+ characters).
WREN_STUDIO_ENABLED=false
WREN_STUDIO_PASSWORD=
WREN_STUDIO_DATA_DIR=.state/studio
WREN_STUDIO_COOKIE_SECURE=false
WREN_STUDIO_MAX_REQUEST_BYTES=1048576
